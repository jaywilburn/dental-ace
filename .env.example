# AADB Platform Suite — Phase 0 / Phase 1 environment contract.
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Supabase ---------------------------------------------------------------
# All values are visible in the Supabase dashboard:
#   Project Settings → Data API   for the URL + anon key
#   Project Settings → API Keys   for the service-role key
NEXT_PUBLIC_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# server-only, NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Personal Access Token used by the Supabase MCP server (scripts/run-supabase-mcp.sh
# loads this file before launching the MCP). Create at:
#   https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...

# Storage bucket names (created in Phase 0 via MCP).
SUPABASE_STORAGE_BUCKET_CERTS=certificates
SUPABASE_STORAGE_BUCKET_UPLOADS=uploads

# --- Database (Prisma) ------------------------------------------------------
# Both come from the Supabase dashboard:
#   Project Settings → Database → Connection string
# DATABASE_URL = the pooled (transaction-mode) connection — for runtime queries.
# DIRECT_URL   = the direct (session-mode) connection — for Prisma migrations.
DATABASE_URL=postgresql://postgres:<PASSWORD>@<HOST>:6543/postgres?pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://postgres:<PASSWORD>@<HOST>:5432/postgres

# --- App --------------------------------------------------------------------
# Canonical base URL. MUST be set in production: outbound email links (email
# verification) are built from this, never the request Host header, to prevent
# host-header injection. Falls back to https://dentalace.org in prod if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# HMAC secret for our session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 chars. Rotating it logs everyone out (cookies become invalid).
SESSION_SECRET=replace_me_with_48+_random_bytes_base64url

# --- Stripe ------------------------------------------------------------------
# Secret key. Drives BOTH the app's real-mode billing AND the Stripe MCP server
# (scripts/run-stripe-mcp.sh loads this file before launching the MCP). Use a
# TEST key (sk_test_...) in dev. Setting this alone flips the app into real mode;
# pair it with STRIPE_MOCK_MODE=true (below) to keep dev demos on the mock flow.
# STRIPE_SECRET_KEY=sk_test_...
#
# Webhook signing secret. From `stripe listen` locally, or the Dashboard endpoint
# in prod. Required for the real /api/webhooks/stripe handler.
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# Force mock mode even when STRIPE_SECRET_KEY is present. Keep =true in dev to
# stay on the in-app mock checkout pages. UNSET (or =false) for real payments
# (real DentalACE one-time checkout + ProTrack Pro subscriptions are both wired).
# STRIPE_MOCK_MODE=true
#
# Publishable key. NOT currently read by any code (hosted Checkout redirects, no
# client-side Stripe.js yet). Optional / forward-looking only.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
#
# --- Stripe Price IDs --------------------------------------------------------
# DentalACE one-time checkout (course applications + cert bundles) builds Stripe
# sessions from inline price_data keyed off lib/billing/catalog.ts, so these
# STRIPE_PRICE_ID_APP_COURSE / STRIPE_PRICE_ID_CERT_* vars are NOT read and do
# not need to be set. Left here as forward-looking only (in case we ever switch
# to pre-created Stripe Prices).
# STRIPE_PRICE_ID_APP_COURSE=price_...
# STRIPE_PRICE_ID_CERT_50=price_...
# STRIPE_PRICE_ID_CERT_100=price_...
# STRIPE_PRICE_ID_CERT_200=price_...
# STRIPE_PRICE_ID_CERT_300=price_...
# STRIPE_PRICE_ID_CERT_500=price_...
# STRIPE_PRICE_ID_CERT_750=price_...
# STRIPE_PRICE_ID_CERT_1500=price_...
# ProTrack Pro subscriptions DO use real Prices (line_items: [{ price }]) and
# are REQUIRED for real-mode Pro upgrades:
# STRIPE_PRICE_ID_PRO_MONTHLY=price_...   # $7/mo
# STRIPE_PRICE_ID_PRO_ANNUAL=price_...    # $67/yr

# --- Resend (Week 5 onwards) ------------------------------------------------
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=noreply@dentalace.org
# Testing only: comma-separated addresses BCC'd on EVERY outbound email so the
# client can confirm each template fires. Leave UNSET in production.
# EMAIL_TEST_BCC=john@dentalace.org,christy@dentalace.org

# --- ProTrack reminder cron (Phase 2) ---------------------------------------
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=replace_me_with_a_long_random_string

# --- Admin notifications ----------------------------------------------------
# AADB_ADMIN_EMAIL=
# REVIEWER_NOTIFICATION_EMAILS=
