// DentalACE One — Prisma schema
//
// Phase 1 (DentalACE) tables + Phase 2 (ProTrack) tables live here. Phase 2 was
// pulled forward at the client's request (see CLAUDE.md). Phase 3 (Verify) tables
// are added when that phase starts. See PRD-phase-1-dental-ace.md §4 for the
// Phase 1 data model and the rationale behind each column.
//
// RLS policies are managed separately as raw-SQL migrations in /sql-migrations
// (Prisma doesn't manage RLS). The Supabase MCP applies them via apply_migration.
//
// Column naming: snake_case at the DB layer (Postgres convention; lets RLS SQL
// use unquoted identifiers), camelCase at the Prisma client layer via @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Internal AADB staff only. Customer-facing access is by entitlement columns on
// `users` (company_id = DentalACE, protrack_tier = ProTrack, verify_access = Verify),
// not by a role. See CLAUDE.md "Access model".
enum StaffRole {
  NONE
  REVIEWER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum BillingTransactionType {
  APP_CREDIT
  CERT_BUNDLE
  ADMIN_OVERRIDE
}

// ── Phase 2 (ProTrack) enums ────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
}

enum LicenseType {
  DDS_DMD // Dentist
  RDH // Hygienist
  DA // Assistant
}

enum CertSource {
  ACE // auto-synced from a DentalACE-issued certificate
  ADA_CERP
  AGD_PACE
  UPLOADED
}

enum VerificationStatus {
  AUTO // ACE-issued, trusted
  ADA_CERP_ACCEPTED
  AGD_PACE_ACCEPTED
  PENDING // uploaded, awaiting review / auto-accept window
  ADMIN_VERIFIED
}

enum DeliveryFormat {
  IN_PERSON
  ONLINE
  HYBRID
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
  TRIALING
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

enum RequirementStatus {
  PROVISIONAL // seeded best-effort; not board-confirmed
  CONFIRMED // matches John's authoritative file
}

enum AccessRequestKind {
  COMPANY
  BOARD
  REVIEWER
  ADMIN
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  DENIED
}

// What a person declared they were here to do at /signup (the ?as= param). Drives
// the post-verification welcome email: INDIVIDUAL gets the ProTrack welcome, the
// others get the platform welcome (they may never use ProTrack). Nullable: rows
// created before this column fall through to the ProTrack welcome.
enum SignupIntent {
  INDIVIDUAL
  COMPANY
  STAFF
}

// ── Phase 3 (Verify) enums ──────────────────────────────────────────────────

enum BatchStatus {
  ACTIVE
  CLOSED
}

enum ComplianceStatus {
  COMPLIANT
  IN_PROGRESS // > 50% of required hours present
  DEFICIENT
  NO_UPLOAD
}

enum DeficiencyStatus {
  PENDING
  RESOLVED
  ESCALATED // deadline passed; still deficient
}

enum NoticeType {
  INITIAL
  FOLLOWUP_30D
  FINAL_7D
  RESOLVED_CONFIRMATION
  PROTRACK_INVITE
}

// One account per user. Access is read off this row:
//   staff_role     -> internal staff areas (/reviewer, /admin)
//   company_id     -> DentalACE (the company holds prepaid credits/billing)
//   protrack_tier  -> ProTrack (every account is FREE; PRO is the paid upgrade)
//   verify_access  -> Verify (admin-granted)
// ProTrack profile + data (name, tier, licenses, certs) live on / hang off this row.
model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  staffRole        StaffRole @default(NONE) @map("staff_role")
  companyId        String?   @map("company_id") @db.Uuid
  company          Company?  @relation(fields: [companyId], references: [id])
  protrackTier     PlanTier  @default(FREE) @map("protrack_tier")
  signupIntent     SignupIntent? @map("signup_intent") // what they picked at /signup; tailors the welcome email
  proExpiresAt     DateTime? @map("pro_expires_at")
  verifyAccess     Boolean   @default(false) @map("verify_access")
  // Set for users who registered through /signup/board. Multiple verify users for
  // the same state share one board row (find-or-create on signup).
  boardId          String?   @map("board_id") @db.Uuid
  board            Board?    @relation(fields: [boardId], references: [id])
  reminderSettings Json      @default("{}") @map("reminder_settings") // {d90,d60,d30,d7,categoryGap}
  emailVerifiedAt  DateTime? @map("email_verified_at") // null until the signup email is confirmed
  // Set by an app admin to suspend the account: blocks sign-in (route + session
  // guard) and is reversible. We never hard-delete a user (compliance/audit), so
  // suspension is the terminal lifecycle state. See lib/admin/users.ts.
  disabledAt       DateTime? @map("disabled_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastLogin        DateTime? @map("last_login")
  // Set by scripts/provision-legacy-accounts.ts when this account was created from
  // a migrated legacy attendee email (not a self-serve signup). Marks the cohort
  // eligible for the one-time set-password activation email. Null for everyone else.
  legacyProvisionedAt   DateTime? @map("legacy_provisioned_at")
  // Set by scripts/send-legacy-invites.ts when the activation email was sent, so
  // the batch is resumable and never double-sends. Null = not yet invited.
  activationEmailSentAt DateTime? @map("activation_email_sent_at")

  reviewedApplications  CourseApplication[] @relation("ReviewedBy")
  reviewedEvents        Event[]             @relation("EventReviewedBy")
  licenses              UserLicense[]
  certificates          CeCertificate[]
  subscription          ProSubscription?
  initiatedAuditBatches AuditBatch[]        @relation("InitiatedBy")
  sentNotices           NoticeSent[]        @relation("SentBy")
  adminActionsPerformed AdminAuditLog[]     @relation("AdminActor")
  adminActionsTargeting AdminAuditLog[]     @relation("AdminTarget")
  accessRequests        AccessRequest[]     @relation("AccessRequester")
  accessRequestsDecided AccessRequest[]     @relation("AccessDecider")
  platformSettingsUpdated PlatformSettings[] @relation("PlatformSettingsUpdatedBy")

  @@map("users")
}

// Append-only ledger of app-admin actions on users (role/entitlement changes,
// suspensions, profile edits, verification/password resets). ADMIN-readable
// (RLS in sql-migrations). Written in-transaction with the mutation it records
// via lib/admin/audit.ts recordAdminAction(). targetUserId is null for actions
// whose target row no longer exists; the target's identity is kept in details.
enum AdminAuditAction {
  PROFILE_UPDATED
  STAFF_ROLE_CHANGED
  COMPANY_LINKED
  COMPANY_UNLINKED
  PROTRACK_TIER_CHANGED
  VERIFY_ACCESS_CHANGED
  ACCOUNT_SUSPENDED
  ACCOUNT_UNSUSPENDED
  WORK_REASSIGNED
  EMAIL_VERIFIED_MANUALLY
  VERIFICATION_RESENT
  SET_PASSWORD_LINK_SENT
  STAFF_ACCOUNT_CREATED
  ACCOUNT_DELETED
  ACCESS_REQUEST_APPROVED
  ACCESS_REQUEST_DENIED
  LETTER_SETTINGS_UPDATED
  COMPANY_RENAMED
  COURSE_QUIZ_UPDATED
}

model AdminAuditLog {
  id           String           @id @default(uuid()) @db.Uuid
  actorUserId  String           @map("actor_user_id") @db.Uuid
  actor        User             @relation("AdminActor", fields: [actorUserId], references: [id])
  targetUserId String?          @map("target_user_id") @db.Uuid
  target       User?            @relation("AdminTarget", fields: [targetUserId], references: [id])
  action       AdminAuditAction
  summary      String
  details      Json             @default("{}")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("admin_audit_log")
}

model PlatformSettings {
  id                 String   @id @default("singleton")
  presidentName      String   @default("Dr. Clifford Feingold, DDS") @map("president_name")
  presidentTitle     String   @default("President, American Association of Dental Boards") @map("president_title")
  // Path in the private `uploads` bucket, e.g. "admin/president-signature.png".
  // Null => render the president name in the embedded script font instead.
  signatureImagePath String?  @map("signature_image_path")
  signatureImageMime String?  @map("signature_image_mime")
  updatedAt          DateTime @updatedAt @map("updated_at")
  updatedById        String?  @map("updated_by_id") @db.Uuid
  updatedBy          User?    @relation("PlatformSettingsUpdatedBy", fields: [updatedById], references: [id])

  @@map("platform_settings")
}

model AccessRequest {
  id              String              @id @default(uuid()) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  // FK ON DELETE RESTRICT: deleting a user who has access requests is blocked; deprovision via the admin user flow first.
  // decidedBy below is SET NULL on admin deletion so historical requests are preserved.
  user            User                @relation("AccessRequester", fields: [userId], references: [id])
  kind            AccessRequestKind
  status          AccessRequestStatus @default(PENDING)
  // Kind-specific data. COMPANY -> full company-register form; BOARD -> {state, boardName}; staff -> {}.
  payload         Json                @default("{}")
  // Optional free-text justification (any kind).
  note            String?
  // Denormalized one-line description for the admin queue (no JSON parse needed).
  label           String

  decidedByUserId String?             @map("decided_by_user_id") @db.Uuid
  decidedBy       User?               @relation("AccessDecider", fields: [decidedByUserId], references: [id])
  decidedAt       DateTime?           @map("decided_at")
  denyReason      String?             @map("deny_reason")
  createdAt       DateTime            @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([userId, status])
  @@map("access_requests")
}

model Company {
  id                          String    @id @default(uuid()) @db.Uuid
  name                        String    @unique
  contactEmail                String?   @map("contact_email")
  contactPhone                String?   @map("contact_phone")
  addressLine1                String?   @map("address_line1")
  addressLine2                String?   @map("address_line2")
  city                        String?
  state                       String?   @db.Char(2)
  zip                         String?
  stripeCustomerId            String?   @unique @map("stripe_customer_id")
  applicationCredits          Int       @default(0) @map("application_credits")
  certBalance                 Int       @default(0) @map("cert_balance")
  certAlertThreshold          Int       @default(25) @map("cert_alert_threshold")
  totalCertsIssued            Int       @default(0) @map("total_certs_issued")
  // Set when the customer dismisses the "schedule your onboarding call" banner on
  // the company dashboard. Null = still show the banner (new customer).
  onboardingDismissedAt       DateTime? @map("onboarding_dismissed_at")
  // Provenance key for the one-time legacy Google Sheet / Typeform import
  // (scripts/migrate-legacy.ts). Null for every natively-created company.
  legacyId                    Int?      @unique @map("legacy_id")
  createdAt                   DateTime  @default(now()) @map("created_at")

  users               User[]
  applications        CourseApplication[]
  accreditedCourses   AccreditedCourse[]
  issuedCertificates  IssuedCertificate[]
  billingTransactions BillingTransaction[]
  events              Event[]

  @@map("companies")
}

model CourseApplication {
  id              String            @id @default(uuid()) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  company         Company           @relation(fields: [companyId], references: [id])
  status          ApplicationStatus @default(DRAFT)
  courseTitle     String?           @map("course_title")
  ceHours         Decimal?          @map("ce_hours") @db.Decimal(5, 2)
  courseType      String?           @map("course_type")
  deliveryMethod  String?           @map("delivery_method")
  applicationData Json              @map("application_data") // all 34 fields per SOW
  submittedAt     DateTime?         @map("submitted_at")
  reviewedById    String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy      User?             @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewerNotes   String?           @map("reviewer_notes")
  reviewedAt      DateTime?         @map("reviewed_at")
  createdAt       DateTime          @default(now()) @map("created_at")

  accreditedCourse AccreditedCourse?

  // When set, this application is a renewal of an existing accredited course;
  // approving it supersedes that course and issues a fresh 3-year accreditation.
  renewalOfCourseId String?           @map("renewal_of_course_id") @db.Uuid
  renewalOfCourse   AccreditedCourse? @relation("CourseRenewals", fields: [renewalOfCourseId], references: [id])

  // When set, this is an inline, event-scoped session application captured in the
  // Event wizard (event-only full-course path). It is NOT a reusable standalone
  // course: excluded from /company/courses, the event attach picker, the standalone
  // application wizard, and the reviewer's standalone application queue. sessionPosition
  // orders the sessions within the event.
  eventId         String?           @map("event_id") @db.Uuid
  event           Event?            @relation("EventSessionApplications", fields: [eventId], references: [id], onDelete: Cascade)
  sessionPosition Int?              @map("session_position")

  @@index([companyId, status])
  @@index([status, submittedAt])
  @@index([renewalOfCourseId])
  @@index([eventId])
  @@map("course_applications")
}

model AccreditedCourse {
  id                String            @id @default(uuid()) @db.Uuid
  applicationId     String            @unique @map("application_id") @db.Uuid
  application       CourseApplication @relation(fields: [applicationId], references: [id])
  companyId         String            @map("company_id") @db.Uuid
  company           Company           @relation(fields: [companyId], references: [id])
  courseIdNumber    String            @unique @map("course_id_number") // ACE-YYYY-#####
  approvedAt        DateTime          @map("approved_at")
  expiresAt         DateTime          @map("expires_at") // approvedAt + 3 years
  attendeeLinkToken String            @unique @default(uuid()) @map("attendee_link_token") @db.Uuid
  qrCodeUrl         String?           @map("qr_code_url")
  approvalLetterUrl String?           @map("approval_letter_url")
  quizQuestions     Json              @map("quiz_questions") // 5-question quiz
  certsIssuedCount  Int               @default(0) @map("certs_issued_count")
  // Set when a renewal of this course is approved; the old row is kept for
  // history (issued certs still reference it) but is no longer the live course.
  supersededAt      DateTime?         @map("superseded_at")
  // Denormalized event-scope marker: null = ordinary reusable course; non-null =
  // a session of that event (event-only full-course path), hidden from
  // /company/courses and the attach picker. Set at approval alongside the
  // matching EventSession(courseId).
  eventId           String?           @map("event_id") @db.Uuid
  event             Event?            @relation("EventScopedCourses", fields: [eventId], references: [id])
  // Provenance key for the one-time legacy import (scripts/migrate-legacy.ts);
  // holds the legacy source course id. Null for natively-accredited courses.
  legacyId          Int?              @unique @map("legacy_id")
  createdAt         DateTime          @default(now()) @map("created_at")

  issuedCertificates  IssuedCertificate[]
  eventSessions       EventSession[]
  renewalApplications CourseApplication[] @relation("CourseRenewals")

  @@index([companyId])
  @@index([expiresAt])
  @@index([eventId])
  @@map("accredited_courses")
}

// The four event types, derived from the two qualifier answers (coverage +
// reuse) at event-submission time. See logic spec "Event Types".
enum EventType {
  FULL_EVENT_QUIZ // Opt 1: full attendance, event-level accreditation, 5-question event quiz
  FULL_PER_COURSE // Opt 2: full attendance, per-course accreditation attached to the event
  SELECTIVE_INLINE // Opt 3: selective, event-level accreditation with inline sessions
  SELECTIVE_PER_COURSE // Opt 4: selective, per-course accreditation attached to the event
}

model Event {
  id                String            @id @default(uuid()) @db.Uuid
  companyId         String            @map("company_id") @db.Uuid
  company           Company           @relation(fields: [companyId], references: [id])
  name              String
  eventDate         String            @map("event_date") // free-form e.g. "June 14-15, 2026"
  status            ApplicationStatus @default(DRAFT)
  // Null while the pre-qualifier draft; set once the two qualifier questions answered.
  eventType         EventType?        @map("event_type")
  // Org/contact + qualifier answers + (Opt 1) the 5-question event quiz.
  eventData         Json              @default("{}") @map("event_data")
  // Input for Opt 1; summed from sessions/courses for Opt 2/3/4.
  totalHours        Decimal?          @map("total_hours") @db.Decimal(5, 2)
  // Set on approval: ACE-EVT-YYYY-#####.
  eventIdNumber     String?           @unique @map("event_id_number")
  approvedAt        DateTime?         @map("approved_at")
  expiresAt         DateTime?         @map("expires_at") // approvedAt + 3 years
  attendeeLinkToken String            @unique @default(uuid()) @map("attendee_link_token") @db.Uuid
  qrCodeUrl         String?           @map("qr_code_url")
  approvalLetterUrl String?           @map("approval_letter_url")
  submittedAt       DateTime?         @map("submitted_at")
  reviewedById      String?           @map("reviewed_by_id") @db.Uuid
  reviewedBy        User?             @relation("EventReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt        DateTime?         @map("reviewed_at")
  reviewerNotes     String?           @map("reviewer_notes")
  certsIssuedCount  Int               @default(0) @map("certs_issued_count")
  createdAt         DateTime          @default(now()) @map("created_at")

  sessions           EventSession[]
  issuedCertificates IssuedCertificate[]
  // Inline session applications captured in the wizard (event-only full-course
  // path) before approval, and the event-scoped courses they become after.
  sessionApplications CourseApplication[] @relation("EventSessionApplications")
  scopedCourses       AccreditedCourse[]  @relation("EventScopedCourses")

  @@index([companyId])
  @@index([status, submittedAt])
  @@map("events")
}

model EventSession {
  id            String            @id @default(uuid()) @db.Uuid
  eventId       String            @map("event_id") @db.Uuid
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  // Set for Opt 2/4 (course-backed); null for Opt 3 inline sessions.
  courseId      String?           @map("course_id") @db.Uuid
  course        AccreditedCourse? @relation(fields: [courseId], references: [id])
  position      Int               @default(0)
  // Inline-session fields (Opt 3): name, duration (0.5 increments), and a single
  // MC question {type:"MC",question,options[4],correctIndex}.
  name          String?
  durationHours Decimal?          @map("duration_hours") @db.Decimal(4, 2)
  question      Json?
  // Per-session Course Information (SELECTIVE_INLINE; step1Schema shape).
  // name/durationHours are mirrored from courseTitle/ceCreditHours at save so
  // quiz assembly, scoring, certificates, and totalHours read them unchanged.
  // Null on sessions saved before July 2026.
  courseInfo    Json?             @map("course_info")

  // PG treats multiple NULL course_ids as distinct, so many inline rows are
  // allowed; this still blocks attaching the same course twice.
  @@unique([eventId, courseId])
  @@index([eventId])
  @@index([courseId])
  @@map("event_sessions")
}

model IssuedCertificate {
  id             String            @id @default(uuid()) @db.Uuid
  // Course certs set courseId; event certs set eventId. Exactly one is set
  // (enforced by a CHECK in sql-migrations/0014). courseId relaxed to nullable
  // for event certs; existing course certs are unaffected (still set courseId).
  courseId       String?           @map("course_id") @db.Uuid
  course         AccreditedCourse? @relation(fields: [courseId], references: [id])
  eventId        String?           @map("event_id") @db.Uuid
  event          Event?            @relation(fields: [eventId], references: [id])
  companyId      String            @map("company_id") @db.Uuid
  company        Company           @relation(fields: [companyId], references: [id])
  attendeeName   String            @map("attendee_name")
  attendeeEmail  String            @map("attendee_email")
  licenseNumber  String?           @map("license_number")
  licenseType    String?           @map("license_type")
  licenseStates  String[]          @map("license_states") // 2-char codes
  deliveryMethod String?           @map("delivery_method")
  courseType     String?           @map("course_type")
  quizResponses  Json              @map("quiz_responses")
  score          Int
  passed         Boolean
  certPdfUrl     String?           @map("cert_pdf_url")
  // Stored CE hours for EVENT certs (total for Opt 1/2, attended-sum for Opt
  // 3/4). Null for course certs, which read hours from course.application.ceHours.
  ceHours        Decimal?          @map("ce_hours") @db.Decimal(5, 2)
  // EventSession ids the attendee selected (Opt 3/4). Null for full-attendance
  // or course certs.
  attendedSessionIds Json?         @map("attended_session_ids")
  // Course completion date as entered by the attendee ("when did you take the
  // course?"). Nullable: legacy rows fall back to issuedAt. Flows to the
  // certificate PDF and the ProTrack CE record (see lib/protrack/ace-sync.ts).
  completedAt    DateTime?         @map("completed_at")
  // Dedup/provenance key for the one-time legacy import: the legacy cert_number
  // (e.g. LEGACY-DA255-00001). Unique, so re-running the importer is idempotent.
  // Null for every natively-issued certificate.
  legacyCertNumber String?         @unique @map("legacy_cert_number")
  issuedAt       DateTime          @default(now()) @map("issued_at")

  ceCertificate CeCertificate? // Phase 2: the ProTrack copy once auto-synced

  @@index([companyId, issuedAt])
  @@index([courseId])
  @@index([eventId])
  @@index([attendeeEmail])
  @@map("issued_certificates")
}

model BillingTransaction {
  id              String                 @id @default(uuid()) @db.Uuid
  companyId       String                 @map("company_id") @db.Uuid
  company         Company                @relation(fields: [companyId], references: [id])
  type            BillingTransactionType
  quantity        Int                    @default(1)
  amountCents     Int                    @map("amount_cents")
  stripePaymentId String?                @map("stripe_payment_id")
  stripeEventId   String?                @unique @map("stripe_event_id") // webhook idempotency key
  performedById   String?                @map("performed_by_id") @db.Uuid // for ADMIN_OVERRIDE
  createdAt       DateTime               @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("billing_transactions")
}

// ── Phase 2 (ProTrack) models ───────────────────────────────────────────────
//
// ProTrack data hangs directly off the user. The child tables keep their
// `licensee_id` column name (a "licensee" is just a user using ProTrack) but the
// FK references users.id. RLS scopes ProTrack data by licensee_id = auth.uid().
// See sql-migrations/0008_unified_access_rls.sql.

model UserLicense {
  id            String      @id @default(uuid()) @db.Uuid
  licenseeId    String      @map("licensee_id") @db.Uuid
  user          User        @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  state         String      @db.Char(2) // 2-char code, joins state_requirements.state
  licenseType   LicenseType @map("license_type")
  licenseNumber String      @map("license_number")
  renewalDate   DateTime    @map("renewal_date")
  isPrimary     Boolean     @default(false) @map("is_primary")
  createdAt     DateTime    @default(now()) @map("created_at")

  auditSelections AuditSelection[]
  deficiencies    Deficiency[]

  @@unique([licenseeId, state, licenseType])
  @@index([licenseeId])
  @@index([state, licenseType]) // join key into state_requirements
  @@index([licenseNumber]) // ACE-sync match key
  @@map("user_licenses")
}

model CeCertificate {
  id                  String             @id @default(uuid()) @db.Uuid
  licenseeId          String             @map("licensee_id") @db.Uuid
  user                User               @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  courseTitle         String             @map("course_title")
  provider            String
  source              CertSource
  category            String // matches a state_requirements category name
  hours               Decimal            @db.Decimal(5, 2)
  deliveryFormat      DeliveryFormat?    @map("delivery_format") // gates In-Person-only categories
  completedAt         DateTime           @map("completed_at")
  verificationStatus  VerificationStatus @map("verification_status")
  fileUrl             String?            @map("file_url") // Supabase Storage path (uploads bucket)
  certNumber          String?            @map("cert_number")
  // Link back to the auto-synced ACE cert (null for uploaded / CERP / PACE). The
  // @unique makes the ACE backfill idempotent — one ProTrack cert per issued cert.
  issuedCertificateId String?            @unique @map("issued_certificate_id") @db.Uuid
  issuedCertificate   IssuedCertificate? @relation(fields: [issuedCertificateId], references: [id])
  createdAt           DateTime           @default(now()) @map("created_at")

  @@index([licenseeId, completedAt])
  @@index([licenseeId, category])
  @@map("ce_certificates")
}

model StateRequirement {
  id            String            @id @default(uuid()) @db.Uuid
  state         String            @db.Char(2)
  licenseType   LicenseType       @map("license_type")
  totalHours    Decimal           @map("total_hours") @db.Decimal(5, 2)
  cycleMonths   Int               @map("cycle_months") // 12 / 24 / 36 (months, not years)
  renewalMonth  Int?              @map("renewal_month") // 1-12 for fixed-month boards (TX = 12)
  categories    Json // [{name, hours, format: "ANY" | "IN_PERSON" | "ONLINE"}]
  status        RequirementStatus @default(PROVISIONAL)
  source        String? // provenance note; John's authoritative file overwrites
  lastUpdatedAt DateTime          @updatedAt @map("last_updated_at")

  @@unique([state, licenseType])
  @@map("state_requirements")
}

model ProSubscription {
  licenseeId           String               @id @map("licensee_id") @db.Uuid
  user                 User                 @relation(fields: [licenseeId], references: [id], onDelete: Cascade)
  stripeCustomerId     String               @map("stripe_customer_id")
  stripeSubscriptionId String               @unique @map("stripe_subscription_id")
  status               SubscriptionStatus
  interval             SubscriptionInterval
  currentPeriodEnd     DateTime             @map("current_period_end")
  cancelAtPeriodEnd    Boolean              @default(false) @map("cancel_at_period_end")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@index([stripeCustomerId])
  @@map("pro_subscriptions")
}

model BoardInvite {
  id           String       @id @default(uuid()) @db.Uuid
  code         String       @unique
  state        String       @db.Char(2)
  licenseType  LicenseType? @map("license_type")
  email        String? // optional pre-fill / restriction
  usedByUserId String?      @map("used_by_user_id") @db.Uuid
  usedAt       DateTime?    @map("used_at")
  expiresAt    DateTime?    @map("expires_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([code])
  @@map("board_invites")
}

// Cron send-once ledger: one row per (licensee, license, threshold, cycle).
// INSERT ... ON CONFLICT DO NOTHING is the idempotency guard, same idiom as
// billing_transactions.stripeEventId.
model ProtrackReminderLog {
  id               String   @id @default(uuid()) @db.Uuid
  licenseeId       String   @map("licensee_id") @db.Uuid
  licenseId        String   @map("license_id") @db.Uuid
  threshold        String // "d90" | "d60" | "d30" | "d7" | "categoryGap"
  cycleRenewalDate DateTime @map("cycle_renewal_date")
  sentAt           DateTime @default(now()) @map("sent_at")

  @@unique([licenseeId, licenseId, threshold, cycleRenewalDate])
  @@map("protrack_reminder_log")
}

// Dedupe / cooldown store for the Dental ACE lifecycle cron
// (app/api/cron/dental-ace-lifecycle). Written by the cron via the service-role
// client; ADMIN-readable under RLS (sql-migrations/0010). refId is NOT NULL
// (Postgres treats NULLs as distinct in unique constraints, which would silently
// break dedupe): courseId for course_* kinds, companyId for company-level kinds.
model NotificationLog {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  kind      String // course_expiring_60 | course_expiring_30 | credits_expiring_30 | low_balance | balance_exhausted
  refId     String   @map("ref_id") @db.Uuid
  periodKey String   @map("period_key")
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([companyId, kind, refId, periodKey])
  @@index([companyId, kind, sentAt])
  @@map("notification_log")
}

// ── Phase 3 (Verify) models ─────────────────────────────────────────────────
//
// State-board portal. A board has one or more BOARD admin users (users.boardId)
// and runs random audits against in-state licensees, sourcing CE state from the
// ProTrack tables above (UserLicense, CeCertificate, StateRequirement).
//
// Owned by Phase 3. Schema is purely additive — no edits to Phase 1/2 models.

// One row per state board. Multiple board users in the same state share this row.
model Board {
  id                String   @id @default(uuid()) @db.Uuid
  state             String   @unique @db.Char(2)
  name              String // "Texas State Board of Dental Examiners"
  adminEmail        String?  @map("admin_email")
  dailySummaryEmail String?  @map("daily_summary_email")
  settings          Json     @default("{}") // { defaultSamplePercent, deficiencyResponseDays, autoFollowup30d, autoFinal7d, publicLookupEnabled, dailySummaryEnabled }
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  users        User[]
  auditBatches AuditBatch[]

  @@map("boards")
}

// One row per audit run. batch_code is the human-readable handle (TX-2026-003).
model AuditBatch {
  id             String       @id @default(uuid()) @db.Uuid
  boardId        String       @map("board_id") @db.Uuid
  board          Board        @relation(fields: [boardId], references: [id])
  batchCode      String       @unique @map("batch_code")
  name           String
  samplePercent  Int          @map("sample_percent") // 10, 15, 20, 25
  licenseType    LicenseType? @map("license_type") // null = all types
  renewalCycle   String       @map("renewal_cycle") // "2024-2026"
  selectedCount  Int          @map("selected_count")
  deficientCount Int          @map("deficient_count")
  status         BatchStatus  @default(ACTIVE)
  initiatedById  String       @map("initiated_by_id") @db.Uuid
  initiatedBy    User         @relation("InitiatedBy", fields: [initiatedById], references: [id])
  createdAt      DateTime     @default(now()) @map("created_at")

  selections   AuditSelection[]
  deficiencies Deficiency[]

  @@index([boardId, createdAt])
  @@map("audit_batches")
}

// Snapshot of a licensee's CE state at audit time. One per licensee per batch.
model AuditSelection {
  id               String           @id @default(uuid()) @db.Uuid
  batchId          String           @map("batch_id") @db.Uuid
  batch            AuditBatch       @relation(fields: [batchId], references: [id])
  userLicenseId    String           @map("user_license_id") @db.Uuid
  userLicense      UserLicense      @relation(fields: [userLicenseId], references: [id])
  ceHoursCompleted Decimal          @map("ce_hours_completed") @db.Decimal(5, 2)
  ceHoursRequired  Decimal          @map("ce_hours_required") @db.Decimal(5, 2)
  complianceStatus ComplianceStatus @map("compliance_status")
  createdAt        DateTime         @default(now()) @map("created_at")

  @@unique([batchId, userLicenseId])
  @@index([batchId, complianceStatus])
  @@map("audit_selections")
}

model Deficiency {
  id                String           @id @default(uuid()) @db.Uuid
  batchId           String           @map("batch_id") @db.Uuid
  batch             AuditBatch       @relation(fields: [batchId], references: [id])
  userLicenseId     String           @map("user_license_id") @db.Uuid
  userLicense       UserLicense      @relation(fields: [userLicenseId], references: [id])
  missingHours      Decimal          @map("missing_hours") @db.Decimal(5, 2)
  missingCategories Json             @map("missing_categories") // ["Sedation","Infection Control"]
  noticesSentCount  Int              @default(0) @map("notices_sent_count")
  deadlineAt        DateTime?        @map("deadline_at") // set on first INITIAL notice
  status            DeficiencyStatus @default(PENDING)
  resolvedAt        DateTime?        @map("resolved_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  notices NoticeSent[]

  @@index([batchId, status])
  @@index([status, deadlineAt])
  @@map("deficiencies")
}

// Audit trail for board → licensee emails. resend_message_id backfilled after
// the Resend call succeeds; null until then. Idempotency guard: insert-then-send,
// drop the row if Resend rejects.
model NoticeSent {
  id              String     @id @default(uuid()) @db.Uuid
  deficiencyId    String     @map("deficiency_id") @db.Uuid
  deficiency      Deficiency @relation(fields: [deficiencyId], references: [id])
  noticeType      NoticeType @map("notice_type")
  recipientEmail  String     @map("recipient_email")
  sentAt          DateTime   @default(now()) @map("sent_at")
  sentById        String?    @map("sent_by_id") @db.Uuid // null for cron sends
  sentBy          User?      @relation("SentBy", fields: [sentById], references: [id])
  resendMessageId String?    @map("resend_message_id")

  @@index([deficiencyId, sentAt])
  @@map("notices_sent")
}

// ── Marketing (lead capture) ────────────────────────────────────────────────
//
// Contact/early-access leads from the pre-launch marketing pages (VerifyIQ and
// Verify). Not a product table: it just captures interest submitted on the
// already-shipped landing forms, replacing the earlier mailto: placeholder.
// Writes run server-side via Prisma (table owner, bypasses RLS); RLS
// (sql-migrations/0016) is the floor that keeps anon/authenticated clients from
// reading leads. Admin-viewable at /admin/leads.

enum MarketingLeadSource {
  VERIFYIQ
  VERIFY
}

model MarketingLead {
  id           String              @id @default(uuid()) @db.Uuid
  source       MarketingLeadSource
  contactName  String              @map("contact_name")
  title        String?
  organization String
  email        String
  message      String?
  createdAt    DateTime            @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("marketing_leads")
}
